# Server
PORT=5000
NODE_ENV=development
APP_NAME=GhostAir
APP_URL=http://localhost:3000

# Database
MONGO_URI=mongodb://localhost:27017/ghostair

# JWT secrets — generate long random strings for production
JWT_ACCESS_SECRET=replace_with_long_random_string_min_64_chars
JWT_REFRESH_SECRET=replace_with_another_long_random_string_min_64_chars
JWT_RESET_SECRET=replace_with_yet_another_long_random_string_min_64_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Password hashing
BCRYPT_ROUNDS=12

# OTP
OTP_LENGTH=6
OTP_EXPIRES_MINUTES=10

# CORS (comma-separated origins, or * for any)
CORS_ORIGIN=http://localhost:3000

# Resend (https://resend.com) — leave RESEND_API_KEY blank in dev to log emails to stdout
RESEND_API_KEY=
EMAIL_FROM="GhostAir <no-reply@ghostair.io>"
EMAIL_REPLY_TO=support@ghostair.io
SUPPORT_EMAIL=support@ghostair.io
